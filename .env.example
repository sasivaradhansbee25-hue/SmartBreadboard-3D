# ==============================================================
# SmartBreadboard 3D Frontend Environment Configuration
# ==============================================================

# 1. Local Development (Desktop Browser)
# VITE_FRONTEND_BASE_URL=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:8000

# 2. LAN Phone Testing (Testing with physical phone on same Wi-Fi)
# Replace <PC-LAN-IP> with your computer's local IP (e.g. 192.168.1.50)
# VITE_FRONTEND_BASE_URL=http://<PC-LAN-IP>:5173
# VITE_API_BASE_URL=http://<PC-LAN-IP>:8000

# 3. Production Deployment (Vercel + Cloud FastAPI backend)
# Set these variables in your Vercel Project Settings > Environment Variables
VITE_FRONTEND_BASE_URL=https://smartbreadboard-3d.vercel.app
VITE_API_BASE_URL=https://smartbreadboard-api.onrender.com
